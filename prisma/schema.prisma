// One schema, one database, one school (PRD §2.2, ARCHITECTURE.md §4).
// Phase 1: Identity & Access + School/Academic Structure (BUILD_PLAN.md §3).
// Everything else (profiles, subjects, assessment, fees, ...) arrives per-phase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// 3.1 Core Identity Tables (PRD §3.1)
// ---------------------------------------------------------------------------

enum UserStatus {
  invited
  active
  suspended
  archived
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STAFF
  PARENT
  STUDENT
}

// NOTE: PRD specifies `email citext, unique` for case-insensitive login.
// Rather than enabling the Postgres citext extension (an extra migration
// dependency for one column), email is normalized to lowercase at the
// application layer on every write and lookup (UserService) — functionally
// equivalent for the actual use case, with no extension to manage.
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?
  passwordHash String?
  firstName    String
  lastName     String
  middleName   String?
  gender       Gender?
  dateOfBirth  DateTime?  @db.Date
  avatarUrl    String?
  status       UserStatus @default(invited)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  roles           UserRole[]
  sentInvitations Invitation[]    @relation("InvitationSender")
  adminProfile    AdminProfile?
  staffProfile    StaffProfile?
  parentProfile   ParentProfile?
  studentProfile  StudentProfile?

  @@map("users")
}

// Singleton SUPER_ADMIN enforced via a partial unique index added by hand in
// the generated migration (Prisma has no `@@unique(where:)` syntax) — see
// prisma/migrations/*/migration.sql.
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("user_roles")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// Prefill for STAFF invites (PRD §3.1). Lives here (not just on StaffProfile,
// which doesn't exist until Phase 2) because Invitation needs it now.
enum StaffCategory {
  TEACHING
  NON_TEACHING
}

model Invitation {
  id              String           @id @default(uuid())
  email           String
  invitedRole     Role
  staffCategory   StaffCategory?
  invitedByUserId String?
  invitedBy       User?            @relation("InvitationSender", fields: [invitedByUserId], references: [id])
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdAt       DateTime         @default(now())

  @@map("invitations")
}

// ---------------------------------------------------------------------------
// 3.2 School & Academic Structure (PRD §3.2)
// ---------------------------------------------------------------------------

// Singleton — exactly one row, created once by `pnpm setup:school`
// (ARCHITECTURE.md §6.1). Enforced at the application layer (SchoolProfileService
// checks for an existing row before creating).
model SchoolProfile {
  id           String   @id @default(uuid())
  name         String
  address      String?
  logoUrl      String?
  contactEmail String?
  contactPhone String?
  currency     String   @default("NGN")
  timezone     String   @default("Africa/Lagos")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("school_profiles")
}

model AcademicSession {
  id        String   @id @default(uuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  terms            Term[]
  classArms        ClassArm[]
  staffAssignments StaffAssignment[]
  studentPositions StudentPosition[]

  @@map("academic_sessions")
}

model Term {
  id                String          @id @default(uuid())
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  name              String
  startDate         DateTime        @db.Date
  endDate           DateTime        @db.Date
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@unique([academicSessionId, name])
  @@map("terms")
}

enum ClassLevelCategory {
  CRECHE
  NURSERY
  PRIMARY
  JSS
  SSS
}

model ClassLevel {
  id        String             @id @default(uuid())
  name      String             @unique
  order     Int
  category  ClassLevelCategory
  createdAt DateTime           @default(now())

  classArms ClassArm[]

  @@map("class_levels")
}

model ClassArm {
  id                String          @id @default(uuid())
  classLevelId      String
  classLevel        ClassLevel      @relation(fields: [classLevelId], references: [id], onDelete: Cascade)
  name              String
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)
  capacity          Int?
  createdAt         DateTime        @default(now())

  students         StudentProfile[]
  staffAssignments StaffAssignment[]
  studentPositions StudentPosition[]

  @@unique([classLevelId, academicSessionId, name])
  @@map("class_arms")
}

enum DepartmentName {
  SCIENCE
  COMMERCIAL
  ART
}

model Department {
  id          String         @id @default(uuid())
  name        DepartmentName @unique
  description String?
  createdAt   DateTime       @default(now())

  @@map("departments")
}

// ---------------------------------------------------------------------------
// 3.1 / 3.4 / 3.5 People: role-specific profiles, guardianship, staff
// assignments, student positions (PRD §3.1, §3.4, §3.5; BUILD_PLAN.md §4).
// ---------------------------------------------------------------------------

// AdminProfile backs both the SUPER_ADMIN (Proprietor) and ADMIN roles —
// there's no separate SuperAdminProfile table (PRD §4 entity summary: one
// profile type per UserRole).
model AdminProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String?
  employeeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("admin_profiles")
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model StaffProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId     String?
  staffCategory  StaffCategory?
  department     String?
  employmentDate DateTime?      @db.Date
  qualification  String?
  // Denormalized from active StaffAssignment(CLASS_TEACHER) rows — PRD §3.1.
  isClassTeacher Boolean        @default(false)
  status         StaffStatus    @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  assignments StaffAssignment[]

  @@map("staff_profiles")
}

model ParentProfile {
  id                           String                @id @default(uuid())
  userId                       String                @unique
  user                         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  occupation                   String?
  address                      String?
  relationshipToStudentDefault GuardianRelationship?
  createdAt                    DateTime              @default(now())
  updatedAt                    DateTime              @updatedAt

  wards StudentGuardian[]

  @@map("parent_profiles")
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  WITHDRAWN
  SUSPENDED
}

model StudentProfile {
  id              String        @id @default(uuid())
  userId          String        @unique
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  admissionNumber String        @unique
  admissionDate   DateTime      @db.Date
  currentClassId  String?
  currentClass    ClassArm?     @relation(fields: [currentClassId], references: [id])
  studentTitle    String?
  bloodGroup      String?
  medicalNotes    String?
  status          StudentStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guardians StudentGuardian[]
  positions StudentPosition[]

  @@map("student_profiles")
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

// PRD §3.1: a StudentProfile can never exist without >=1 StudentGuardian —
// enforced here at the app layer (transactional create) and, as
// defense-in-depth, by a deferred constraint trigger hand-added to the
// migration SQL (Prisma's DSL can't express cross-table existence checks).
model StudentGuardian {
  id                 String               @id @default(uuid())
  studentId          String
  student            StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId           String
  parent             ParentProfile        @relation(fields: [parentId], references: [id], onDelete: Cascade)
  relationship       GuardianRelationship
  isPrimaryContact   Boolean              @default(false)
  isEmergencyContact Boolean              @default(false)
  createdAt          DateTime             @default(now())

  @@unique([studentId, parentId])
  @@map("student_guardians")
}

enum AssignmentType {
  SUBJECT_TEACHER
  CLASS_TEACHER
  BURSAR
  REGISTRAR
  PRINCIPAL
  VICE_PRINCIPAL
  HEADTEACHER
  OTHER
}

// No DB-level uniqueness for "one active class teacher per class arm" — FR3.3
// (PRD §6.3) is explicit this is a service-layer validation, not a hard
// constraint, so Admin can deliberately override for co-teaching.
model StaffAssignment {
  id                String          @id @default(uuid())
  staffId           String
  staff             StaffProfile    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  assignmentType    AssignmentType
  classArmId        String?
  classArm          ClassArm?       @relation(fields: [classArmId], references: [id])
  subjectId         String?
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  startDate         DateTime?       @db.Date
  endDate           DateTime?       @db.Date
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())

  @@map("staff_assignments")
}

enum PositionScope {
  SCHOOL
  CLASS
}

// PRD §3.5: recommended over a single studentTitle enum column, so a student
// can hold multiple concurrent titles (e.g. Head Boy + Prefect).
model StudentPosition {
  id                String          @id @default(uuid())
  studentId         String
  student           StudentProfile  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  positionName      String
  scope             PositionScope
  classArmId        String?
  classArm          ClassArm?       @relation(fields: [classArmId], references: [id])
  academicSessionId String
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id])
  createdAt         DateTime        @default(now())

  @@map("student_positions")
}
