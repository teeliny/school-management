// One schema, one database, one school (PRD §2.2, ARCHITECTURE.md §4).
// Phase 0: intentionally empty of models — real tables arrive per-phase,
// starting with Identity in Phase 1 (BUILD_PLAN.md §3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
