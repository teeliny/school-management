{
  "name": "@school/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "predev": "pnpm --filter=@school/types build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "preaggregate:demo-scores": "pnpm --filter=@school/types build && nest build",
    "aggregate:demo-scores": "node dist/aggregate-demo-scores.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@school/types": "workspace:*",
    "bullmq": "^5.81.3",
    "pdfkit": "^0.19.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@school/eslint-config": "workspace:*",
    "@school/tsconfig": "workspace:*",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0"
  }
}
