# This school's database (PRD §2.2 — one database, one deployment, per school)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"
# Supabase Postgres (production): use the DIRECT connection string (port 5432,
# Project Settings → Database → Connection string → "URI", not the "Transaction
# pooler" one on port 6543). PrismaPg (apps/api|worker/src/prisma/prisma.service.ts)
# talks to Postgres via plain node-postgres, whose prepared statements don't play
# well with pgbouncer's transaction-pooling mode on 6543 — direct is correct here,
# not a stopgap, given this is a handful of long-lived containers, not serverless.

# Redis (BullMQ, WebSocket pub/sub, refresh-token blacklist)
REDIS_URL="redis://localhost:6379"

# Auth (ARCHITECTURE.md §7). Access tokens are signed JWTs; refresh tokens are
# opaque, hashed the same way as Invitation tokens and stored in Redis — no
# separate refresh-token secret needed.
JWT_ACCESS_SECRET="dev-only-change-me"

# Application-level envelope encryption master key (ARCHITECTURE.md §7) — 32 bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_MASTER_KEY="dev-only-32-byte-base64-key-here"

# Resend (transactional email). If RESEND_API_KEY is unset, MailerService logs
# the email instead of sending it — fine for local dev (PRD §6.1).
RESEND_API_KEY=""
RESEND_FROM_EMAIL="no-reply@example.com"
# Resend dashboard → Webhooks → signing secret (FR8.4) — verifies inbound
# delivery/bounce/complaint events via svix. Only apps/api's webhook
# endpoint reads this.
RESEND_WEBHOOK_SECRET=""

# Base URL of the web app, used to build links in emails (e.g. the invite-accept link).
WEB_BASE_URL="http://localhost:3000"

# Comma-separated list of origins allowed to call api/worker/scheduling-engine
# cross-origin (the browser enforces this, so the web app needs to be listed
# explicitly). Falls back to WEB_BASE_URL above if unset — only set this
# separately if you need multiple allowed origins.
# CORS_ORIGIN="http://localhost:3000"

# Comma-separated allowlist of proprietor emails permitted to call the
# unauthenticated POST /setup/super-admin endpoint (ARCHITECTURE.md §6.1) —
# the HTTP alternative to `pnpm setup:school` for infra without shell/exec
# access. Checked before anything else runs; leave unset to disable the
# endpoint entirely (the CLI script is unaffected). The endpoint also
# hard-disables itself once any Super-Admin is active, regardless of this
# list, so it's only ever usable for the very first setup.
# SETUP_ALLOWED_EMAILS="proprietor@example.com"

# NOTE: Next.js only reads env files from apps/web itself, not this root file —
# see apps/web/.env.example (copy it to apps/web/.env.local) for NEXT_PUBLIC_API_URL.

# Monnify (PRD §6.7) — this school's own merchant credentials, not set here directly;
# stored encrypted in PaymentGatewayConfig once the Fees module exists (Phase 5).
# These are only used for local/dev bootstrapping convenience.
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""
MONNIFY_ENV="SANDBOX"

# Object storage (ARCHITECTURE.md §5 StorageAdapter — Supabase Storage today).
# S3StorageAdapter (apps/api|worker/src/storage/s3-storage-adapter.ts) talks to
# this via the S3-compatible API, region hardcoded to "auto" — get these from
# the Supabase dashboard: Project Settings → Storage → S3 Connection.
#   STORAGE_ENDPOINT   e.g. "https://<project-ref>.supabase.co/storage/v1/s3"
#   STORAGE_BUCKET      the bucket name (create it first: Storage → New bucket)
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY   "New access key" on that same page
#   (not your Supabase service_role/anon key — those don't work here)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Scheduling engine (ARCHITECTURE.md §9)
SCHEDULING_ENGINE_URL="http://localhost:8000"
SCHEDULING_CALLBACK_BASE_URL="http://localhost:3001"
# FR6.9: minutes a ScheduleGenerationRequest can stay QUEUED/SOLVING before
# the timeout sweep marks it TIMED_OUT. Read by apps/worker only.
SCHEDULING_TIMEOUT_MINUTES=10

PORT=3001
WORKER_PORT=3002

# Error tracking (ARCHITECTURE.md §13). If SENTRY_DSN is unset, Sentry.init
# is never called — same behavior as today, no-op — fine for local dev.
SENTRY_DSN=""
# SENTRY_ENVIRONMENT=""
